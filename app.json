{
  "name": "ints-live-otp-bot",
  "description": "INTS SMS LIVE OTP Telegram Bot (ONLY LIVE MODE)",
  "keywords": ["telegram", "otp", "sms", "ints", "python"],
  "env": {
    "BOT_TOKEN": {
      "description": "Telegram Bot Token",
      "required": true
    },
    "CHAT_ID": {
      "description": "Telegram Group/Channel Chat ID",
      "required": true
    },
    "PHPSESSID": {
      "description": "PHPSESSID cookie from INTS panel",
      "required": true
    }
  },
  "formation": {
    "worker": {
      "quantity": 1,
      "size": "basic"
    }
  },
  "buildpacks": [
    { "url": "heroku/python" }
  ]
}
